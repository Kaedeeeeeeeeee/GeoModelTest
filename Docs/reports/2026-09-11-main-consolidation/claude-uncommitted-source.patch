+using UnityEngine;
+using UnityEngine.InputSystem;
+using UnityEngine.UI;
+
+namespace WorkbenchSystem
+{
+    /// <summary>
+    /// 显微镜的"靠近 + 按 F 互动"组件。
+    ///
+    /// 背景：原本由 WorkbenchController 负责，但该组件从未真正挂在场景任何对象上
+    /// （Laboratory Scene 里搜不到 WorkbenchController 的实例），导致"走到显微镜
+    /// 旁边按 F"完全无效。本组件由 MicroscopeController.Start 自动 ensure 添加，
+    /// 不需要手动编辑 .unity 文件。
+    ///
+    /// 行为模仿 QuestNpcInteraction 的提示 UI 风格，保持视觉一致。
+    /// </summary>
+    [RequireComponent(typeof(MicroscopeController))]
+    public class MicroscopeProximityInteractor : MonoBehaviour
+    {
+        [Header("互动设置")]
+        [Tooltip("玩家进入此距离即显示提示并允许按 F 互动")]
+        public float interactionDistance = 4f;
+        [Tooltip("互动键")]
+        public Key interactionKey = Key.F;
+        [Tooltip("提示文本本地化 key")]
+        public string promptLocalizationKey = "ui.microscope.prompt";
+
+        [Header("提示UI样式")]
+        [SerializeField] private Color promptBackgroundColor = new Color(0f, 0f, 0f, 0.65f);
+        [SerializeField] private int promptFontSize = 22;
+
+        private MicroscopeController microscope;
+        private Transform playerTransform;
+        private GameObject promptCanvasGO;
+        private LocalizedText promptLocalized;
+        private bool playerInRange;
+
+        void Awake()
+        {
+            microscope = GetComponent<MicroscopeController>();
+        }
+
+        void Start()
+        {
+            CreatePromptUI();
+        }
+
+        void OnDestroy()
+        {
+            if (promptCanvasGO != null)
+            {
+                Destroy(promptCanvasGO);
+            }
+        }
+
+        void Update()
+        {
+            // 显微镜界面打开时不响应靠近互动（避免在已打开状态下按 F 又触发 toggle close 误操作 — 实际上 toggle 是合理行为，但提示 UI 应隐藏）
+            if (microscope == null) return;
+
+            // 持续找玩家（玩家可能在场景切换后才生成）
+            if (playerTransform == null)
+            {
+                var fp = Object.FindFirstObjectByType<FirstPersonController>();
+                if (fp == null)
+                {
+                    HidePrompt();
+                    return;
+                }
+                playerTransform = fp.transform;
+            }
+
+            float dist = Vector3.Distance(transform.position, playerTransform.position);
+            bool inRange = dist <= interactionDistance;
+
+            // 打开显微镜界面时隐藏靠近提示（避免与界面 UI 重叠）
+            bool microscopeUIActive = IsMicroscopeOpen();
+
+            if (inRange && !microscopeUIActive)
+            {
+                if (!playerInRange) ShowPrompt();
+                playerInRange = true;
+            }
+            else
+            {
+                if (playerInRange) HidePrompt();
+                playerInRange = false;
+            }
+
+            // 检测互动键
+            if (playerInRange && Keyboard.current != null)
+            {
+                var key = Keyboard.current[interactionKey];
+                if (key != null && key.wasPressedThisFrame)
+                {
+                    HidePrompt(); // 立即隐藏提示，让位给显微镜界面
+                    microscope.HandleClick(); // toggle Open/Close
+                }
+            }
+        }
+
+        bool IsMicroscopeOpen()
+        {
+            // MicroscopeController 没有公开 isActive，但 uiRoot.activeSelf 是个可靠的代理
+            return microscope.uiRoot != null && microscope.uiRoot.activeSelf;
+        }
+
+        // ---------- Prompt UI ----------
+        // 风格参考 QuestNpcInteraction.CreatePromptUI，保持游戏内视觉一致
+
+        void CreatePromptUI()
+        {
+            if (promptCanvasGO != null) return;
+
+            promptCanvasGO = new GameObject("MicroscopePromptCanvas");
+
+            var canvas = promptCanvasGO.AddComponent<Canvas>();
+            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
+            canvas.sortingOrder = 160;
+
+            var scaler = promptCanvasGO.AddComponent<CanvasScaler>();
+            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
+            scaler.referenceResolution = new Vector2(1920, 1080);
+
+            promptCanvasGO.AddComponent<GraphicRaycaster>();
+
+            var panel = new GameObject("PromptPanel");
+            panel.transform.SetParent(promptCanvasGO.transform, false);
+            var rect = panel.AddComponent<RectTransform>();
+            rect.anchorMin = new Vector2(0.5f, 0.22f);
+            rect.anchorMax = new Vector2(0.5f, 0.22f);
+            rect.pivot = new Vector2(0.5f, 0.5f);
+            rect.anchoredPosition = Vector2.zero;
+            rect.sizeDelta = new Vector2(420f, 64f);
+
+            var bg = panel.AddComponent<Image>();
+            bg.color = promptBackgroundColor;
+
+            var textObj = new GameObject("PromptText");
+            textObj.transform.SetParent(panel.transform, false);
+            var textRect = textObj.AddComponent<RectTransform>();
+            textRect.anchorMin = Vector2.zero;
+            textRect.anchorMax = Vector2.one;
+            textRect.offsetMin = new Vector2(16f, 12f);
+            textRect.offsetMax = new Vector2(-16f, -12f);
+
+            var text = textObj.AddComponent<Text>();
+            text.font = UIFontResolver.GetUIFont();
+            text.fontSize = promptFontSize;
+            text.color = Color.white;
+            text.alignment = TextAnchor.MiddleCenter;
+
+            promptLocalized = textObj.AddComponent<LocalizedText>();
+            promptLocalized.TextKey = promptLocalizationKey;
+
+            promptCanvasGO.SetActive(false);
+        }
+
+        void ShowPrompt()
+        {
+            if (promptCanvasGO != null && !promptCanvasGO.activeSelf)
+            {
+                promptCanvasGO.SetActive(true);
+            }
+        }
+
+        void HidePrompt()
+        {
+            if (promptCanvasGO != null && promptCanvasGO.activeSelf)
+            {
+                promptCanvasGO.SetActive(false);
+            }
+        }
+    }
+}
