{
    "scene": "Beat3 - 柱状図と化石",
    "background": "field_day",
    "bgm": "field_theme",
    "dialogues": [
        {
            "speaker": "Dr.Kaede",
            "text": "ドリルタワーで、深（ふか）さごとにサンプルを取（と）ろう。地層（ちそう）の重（かさ）なりが「柱状図（ちゅうじょうず）」でわかるよ。",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.beat3.l01"
        },
        {
            "speaker": "主人公",
            "text": "こんな大（おお）きな機械（きかい）で掘（ほ）るなんて……！",
            "speakerKey": "story.speaker.protagonist",
            "textKey": "story.beat3.l05"
        },
        {
            "speaker": "ナレーション",
            "text": "深（ふか）い層（そう）をほり進（すす）めると、岩（いわ）の中（なか）から化石（かせき）が見（み）つかった。",
            "speakerKey": "story.speaker.narration",
            "textKey": "story.beat3.l02"
        },
        {
            "speaker": "主人公",
            "text": "うわ、本物（ほんもの）の化石（かせき）だ……！　何千万年（なんせんまんねん）も前（まえ）の生（い）きものが、今（いま）、目（め）の前（まえ）に。",
            "speakerKey": "story.speaker.protagonist",
            "textKey": "story.beat3.l03"
        },
        {
            "speaker": "ナレーション",
            "text": "ドリルが深（ふか）く進（すす）むほど、足元（あしもと）から低（ひく）い響（ひび）きが伝（つた）わってくる気（き）がした。",
            "speakerKey": "story.speaker.narration",
            "textKey": "story.beat3.l04"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "サンゴの化石（かせき）だ。この地層（ちそう）ができた当時（とうじ）は、どんな環境（かんきょう）だったと考（かんが）えられる？",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.beat3.q1.prompt",
            "questionId": "q.fossil_coral_env",
            "choices": [
                {
                    "text": "あたたかくて浅（あさ）い海（うみ）",
                    "textKey": "story.beat3.q1.a",
                    "isCorrect": true,
                    "feedback": "せいかい！　サンゴはあたたかくて浅（あさ）い海（うみ）にすむ。だから当時（とうじ）の環境（かんきょう）がわかるんだ。",
                    "feedbackKey": "story.beat3.q1.fb_ok"
                },
                {
                    "text": "冷（つめ）たくて深（ふか）い海（うみ）",
                    "textKey": "story.beat3.q1.b",
                    "isCorrect": false
                },
                {
                    "text": "川（かわ）と海（うみ）が混（ま）じる場所（ばしょ）",
                    "textKey": "story.beat3.q1.c",
                    "isCorrect": false
                }
            ]
        },
        {
            "speaker": "Dr.Kaede",
            "text": "サンゴのように、地層（ちそう）ができた当時（とうじ）の「環境（かんきょう）」を教（おし）えてくれる化石（かせき）を何（なに）という？",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.beat3.q2.prompt",
            "questionId": "q.fossil_facies_term",
            "choices": [
                {
                    "text": "示相化石（しそうかせき）",
                    "textKey": "story.beat3.q2.a",
                    "isCorrect": true,
                    "feedback": "そのとおり。環境（かんきょう）を示（しめ）すのが示相化石（しそうかせき）。シジミなら川（かわ）と海（うみ）が混（ま）じる場所（ばしょ）だよ。",
                    "feedbackKey": "story.beat3.q2.fb_ok"
