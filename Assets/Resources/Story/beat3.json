            "questionId": "q.fossil_ammonite_era",
            "questionVersion": "story-formative-v2-fixed-order",
            "hint": "恐竜（きょうりゅう）と同（おな）じ時代（じだい）に栄（さか）えた化石（かせき）は、どの時代（じだい）？",
            "hintKey": "story.beat3.q3.hint",
            "choices": [
                {
