{
    "scene": "Beat1B - G-Lab",
    "background": "laboratory",
    "bgm": "lab_theme",
    "dialogues": [
        {
            "speaker": "主人公",
            "text": "……ここ、どこ？",
            "speakerKey": "story.speaker.protagonist",
            "textKey": "story.s2.l01",
            "ambience": "amb_lab_hum"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "気（き）がついた？　ここは大地（だいち）を調（しら）べる研究所（けんきゅうじょ）「G-Lab」。",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.s2.l02"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "わたしはカエデ。好（す）きなものは、地層（ちそう）とおかし！",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.s2.l03"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "さっきの地震（じしん）で、学校（がっこう）のグラウンドに大（おお）きな割（わ）れ目（め）ができたの。",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.s2.l04"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "地面（じめん）の下（した）で何（なに）が起（お）きているのか、いっしょに調（しら）べてほしい！",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.s2.l05"
        },
        {
            "speaker": "主人公",
            "text": "……わかった、やってみる！",
            "speakerKey": "story.speaker.protagonist",
            "textKey": "story.s2.l06"
        },
        {
            "speaker": "Dr.Kaede",
            "text": "ありがとう！　じゃあまず、こっちに来（き）て！",
            "speakerKey": "story.speaker.drkaede",
            "textKey": "story.s2.l07"
        }
    ]
}
