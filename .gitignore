# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
# Allow WebGL Build directory for Vercel deployment
!/Build/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Visual Studio cache files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2015/2017 cache/options directory
.vs/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Rider
/.idea/

# macOS
.DS_Store

# TextMesh Pro essentials are committed on purpose: the project needs TMP_Settings +
# default font/shaders for ANY TextMeshPro text to render (剧情框/注音依赖). Do not re-ignore.
# [Aa]ssets/TextMesh*Pro/

# 学术参考文献 PDF 仅本地保留（版权考虑，不进仓库；URL 见 ReadingSpeedResearch/reading-speed-analysis.md）
ReadingSpeedResearch/References/

# Plastic SCM
.plastic/

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Timeline
[Aa]ssets/[Cc]onversations.asset

# Fmod cache
fmod_editor.log

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Ignore local WebGL build output
WebGL_Build/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ETC
.vscode/
*.log
.vercel

# Claude Code session data (very large; never commit)
.claude/

# Node dependencies (art-pipeline tooling)
node_modules/

# Dev screenshots
/Text_ScreenShot/
.playwright-cli/
supabase/.temp/
